# ===================================================
# Tapzyy E-Commerce Environment Configuration Template (.env.example)
# ===================================================
# Duplicate this file as .env and fill in your values.
# For Vercel deployment, add these keys under:
# Project Settings > Environment Variables.
# ===================================================

# ---------------------------------------------------
# Supabase Database & API Client
# ---------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# Next.js / Vercel compatibility alias
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# Direct PostgreSQL Database Connection
SUPABASE_DB_HOST=db.your-project-id.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres

# ---------------------------------------------------
# Store Owner & Real-Time Order Notification Email
# ---------------------------------------------------
VITE_ADMIN_NOTIFICATION_EMAIL=your-order-alert-email@gmail.com

# ---------------------------------------------------
# Admin Portal Authentication (Comma-separated lists)
# ---------------------------------------------------
VITE_ADMIN_VALID_EMAILS=admin@yourstore.com,owner@yourstore.com,admin
VITE_ADMIN_VALID_PASSWORDS=your-strong-password-1,your-strong-password-2

# ---------------------------------------------------
# Store Contact & Support
# ---------------------------------------------------
VITE_STORE_CONTACT_EMAIL=support@yourstore.com
VITE_STORE_CONTACT_PHONE=+91 99999 88888
VITE_STORE_WHATSAPP_PHONE=919999988888

# ---------------------------------------------------
# Payment Gateway (Razorpay)
# ---------------------------------------------------
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id

# ---------------------------------------------------
# Custom Domain Order Email Service (info@tapzzy.com)
# ---------------------------------------------------
VITE_STORE_INFO_EMAIL=info@tapzzy.com
VITE_STORE_SENDER_EMAIL=Tapzyy <info@tapzzy.com>
SENDER_EMAIL=Tapzyy <info@tapzzy.com>
# Optional Mail Dispatch Provider Keys (Add on Vercel > Environment Variables):
# RESEND_API_KEY=re_your_resend_api_key
# BREVO_API_KEY=xkeysib-your_brevo_api_key

